.00133,0.00129,0.00127,0.00123,0.0012,0.00116,0.00113,0.00111,0.00108,0.00108,0.00107,0.00103,0.001,0.00099,0.00095,0.0009,0.0009,0.0009,0.00089,0.00087,0.00084,0.00084,0.00084,0.0008,0.00077,0.00074,0.00074,0.00075,0.00074,0.0007,0.00065,0.00061,0.00059,0.00058,0.00057,0.00056,0.00054,0.00051,0.00048,0.00047,0.00047,0.00048,0.00048,0.00049,0.0005,0.00051,0.00049,0.00049,0.00052,0.00051,0.0005,0.00053,0.00052,0.00049,0.00044,0.00043,0.00044,0.00045,0.00044,0.00041,0.0004,0.0004,0.00039,0.00037,0.00035,0.00039,0.00039,0.00038,0.00039,0.00041,0.00043,0.00037,0.00036,0.00038,0.00041,0.00041,0.00037,0.00037,0.00037,0.00037,0.0004,0.0004,0.00039,0.00036,0.00036,0.00038,0.0004,0.00036,0.00034,0.00041,0.00038,0.00033,0.00026,0.0003,0.00032,0.00031,0.00031,0.00031,0.0003,0.00028,0.00029,0.00031,0.00033,0.00031,0.00033,0.00034,0.00029,0.00035,0.00036,0.00033,0.00032,0.00033,0.00034,0.00032,0.00032,0.00034,0.00033,0.00031,0.00037,0.00038,0.00037,0.00037,0.00046,0.0004,0.00034,0.00034]\n        ]\n\n        timer = QTimer(self)\n        timer.timeout.connect(self.pick_random_values_list)\n        timer.start(1000)\n\n    def pick_random_values_list(self):\n        idx = random.randint(0, len(self.values)-1)\n        self.update_plot_data(self.wavelengths, self.values[idx])\n    \n    def init_plot(self):\n        self.grad = QLinearGradient(0, 0, 1, 0)\n        self.grad.setColorAt(0, QColor(255, 0, 0))\n        self.grad.setColorAt(1, QColor(0, 0, 255)) \n        self.grad.setCoordinateMode(QGradient.LogicalMode)\n        background_plot_brush = QBrush(self.grad)\n\n        self.graph_plot = self.plot(\n            [], [],\n            fillLevel=0,\n            brush=background_plot_brush,\n            autoDownsample=True\n        )\n\n        self.getViewBox().sigRangeChanged.connect(self.update_gradient)\n        \n    def update_plot_data(self, wavelengths, values):  \n        if len(wavelengths) != len(values):\n            return\n\n        self.graph_plot.setData(wavelengths, values, autoDownsample=True)  \n        self.update_gradient()\n\n    def update_gradient(self):\n        vb = self.getViewBox()\n        (xmin, xmax), _ = vb.viewRange()\n\n        self.grad.setStart(xmin, 0)\n        self.grad.setFinalStop(xmax, 0)\n        self.graph_plot.setBrush(QBrush(self.grad))\n        \n\nif __name__ == &quot;__main__&quot;:\n    app = QApplication()\n\n    window = MainWindow()\n    window.show()\n\n    sys.exit(app.exec())\n</code></pre>\n", "tags": ["python", "gradient", "pyside6", "pyqtgraph", "qlineargradient"]}
{"id": "1eac8315-19a3-4adb-918c-f0dcaefc7a1b", "text": "Q: Atom/RSS feeds on Github Issues? A: <p>Look at the page source, you'll see a link like:</p>\n\n<pre><code>   &lt;link href=\"https://github.com/org/repo/releases.atom?token=TOKEN\" rel=\"alternate\" title=\"repo Release Notes\" type=\"application/atom+xml\" /&gt;\n</code></pre>\n\n<p>Unless I'm mistaken, that (including the token) is your public URL. </p>\n", "tags": ["github"]}
{"id": "d650acb5-9ee9-4385-989a-9c80ad801c63", "text": "Q: I want to delete rows from a Named Range that contains several items listed in MyArray. But I get an error if not found A: <p>You don't need any error handler when using Find, as long as you check whether it returned a <code>Range</code> (a match was made) or <code>Nothing</code> (no match was made):</p>\n<pre><code>Sub DELETE_Db_ROWS_THAT_CONTAIN_ITEMS_IN_AN_ARRAY()\n    Dim MyArray As Variant, myValue As Variant\n    Dim SearchRng As Range, f As Range, i As Long\n    \n    MyArray = Array(&quot;Reinvest&quot;, &quot;DBS&quot;, &quot;WDL&quot;) 'Delete all rows containing these items\n    Set SearchRng = ThisWorkbook.Worksheets(&quot;Sheet1&quot;).Range(&quot;Test_Range&quot;)\n   \n    For Each myValue In MyArray\n        i = 0\n        Do\n            Set f = SearchRng.Find(What:=CStr(myValue), LookIn:=xlFormulas, _\n                            LookAt:=xlPart, SearchOrder:=xlByRows, _\n                            SearchDirection:=xlNext, MatchCase:=False, SearchFormat:=False)\n                            \n            If Not f Is Nothing Then 'something was found?\n                f.EntireRow.Delete 'remove the row\n                i = i + 1\n            Else\n                Exit Do            'done searching for this term\n            End If\n        Loop\n        Debug.Print &quot;Removed &quot; &amp; i &amp; &quot; row(s) for '&quot; &amp; myValue &amp; &quot;'&quot;\n    Next myValue\nEnd Sub\n</code></pre>\n<p>Your posted use of error handling breaks a few guidelines - see here for a good overview of how to use error handling in VBA:\n<a href=\"http://www.cpearson.com/excel/errorhandling.htm\" rel=\"nofollow noreferrer\">http://www.cpearson.com/excel/errorhandling.htm</a></p>\n", "tags": ["arrays", "vba", "for-loop", "error-handling"]}
